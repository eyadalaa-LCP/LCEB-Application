  "questionnaire": {
    "enabled": true,
    "title": "Start with\nyour story.",
    "subtitle": "QUESTIONNAIRE",
    "groups": [
      {
        "id": "group-0",
        "enabled": true,
        "order": 0,
        "title": "PERSONAL",
        "description": "",
        "questions": [
          {
            "id": "q-0",
            "enabled": true,
            "order": 0,
            "text": "Who are you?"
          },
          {
            "id": "q-1",
            "enabled": true,
            "order": 1,
            "text": "What is your drive to continue in AIESEC and apply for an EB? What do you expect to gain from such experience?"
          },
          {
            "id": "q-2",
            "enabled": true,
            "order": 2,
            "text": "What is your short-term and long-term goal? What are the steps you took towards achieving this goal? How will the EB term help you reach it?"
          },
          {
            "id": "q-3",
            "enabled": true,
            "order": 3,
            "text": "What are your core values? How do your behaviors demonstrate your core values?"
          },
          {
            "id": "q-4",
            "enabled": true,
            "order": 4,
            "text": "List 3 strengths and weaknesses in your personality and your plan to capitalize your strengths and overcome your weaknesses."
          }
        ]
      },
      {
        "id": "group-1",
        "enabled": true,
        "order": 1,
        "title": "LEADERSHIP",
        "description": "",
        "questions": [
          {
            "id": "q-0",
            "enabled": true,
            "order": 0,
            "text": "Define leadership from your point of view."
          },
          {
            "id": "q-1",
            "enabled": true,
            "order": 1,
            "text": "What is your leadership style? Evaluate how effective it is."
          },
          {
            "id": "q-2",
            "enabled": true,
            "order": 2,
            "text": "Who is your role model in leadership and why did you choose him/her?"
          },
          {
            "id": "q-3",
            "enabled": true,
            "order": 3,
            "text": "What leader do you want to see yourself as by the end of your term?"
          }
        ]
      },
      {
        "id": "group-2",
        "enabled": true,
        "order": 2,
        "title": "MANAGEMENT",
        "description": "",
        "questions": [
          {
            "id": "q-0",
            "enabled": true,
            "order": 0,
            "text": "How do you make your decisions?"
          },
          {
            "id": "q-1",
            "enabled": true,
            "order": 1,
            "text": "Give an example of a tough decision you had to make."
          },
          {
            "id": "q-2",
            "enabled": true,
            "order": 2,
            "text": "How do you keep yourself motivated in your dark times?"
          },
          {
            "id": "q-3",
            "enabled": true,
            "order": 3,
            "text": "How do you manage your time to balance among different responsibilities and duties?"
          },
          {
            "id": "q-4",
            "enabled": true,
            "order": 4,
            "text": "How do you want to see your people by the end of their experience with you? And what is your plan to achieve this?"
          }
        ]
      },
      {
        "id": "group-3",
        "enabled": true,
        "order": 3,
        "title": "AIESEC",
        "description": "",
        "questions": [
          {
            "id": "q-0",
            "enabled": true,
            "order": 0,
            "text": "In your point of view, how is AIESEC affecting Egyptian youth?"
          },
          {
            "id": "q-1",
            "enabled": true,
            "order": 1,
            "text": "How do you think AIESEC can be more relevant and start to impact the world through every single exchange we do?"
          },
          {
            "id": "q-2",
            "enabled": true,
            "order": 2,
            "text": "How will you ensure the positioning of your LC in the national plenary?"
          },
          {
            "id": "q-3",
            "enabled": true,
            "order": 3,
            "text": "How will you contribute to AIESEC 2030 as an EB member?"
          }
        ]
      }
    ]
  },
